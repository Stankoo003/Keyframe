# Kopiraj u .env.local i po potrebi izmeni.

# ── Baza ──────────────────────────────────────────────────────────────────────
# Vrednosti ispod odgovaraju servisu `db` iz docker-compose.yml.
DATABASE_URL="postgresql://keyframe:keyframe@localhost:5432/keyframe?schema=public"

# ── Media ─────────────────────────────────────────────────────────────────────
# Odakle app povlaci HLS. Prazno = lokalno iz public/media (dev bez CDN-a).
# Deploy-ovano = javni R2/CDN URL, npr. https://pub-xxxxx.r2.dev
NEXT_PUBLIC_MEDIA_BASE_URL=""

# ── Cloudflare R2 (samo za scripts/sync-r2.sh, ne koristi ih aplikacija) ──────
# Dobija se u Cloudflare dashboard-u: R2 → API → Manage API tokens.
R2_ACCOUNT_ID=""
R2_BUCKET="keyframe-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

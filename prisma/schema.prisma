// Prisma schema — dokumentacija: https://pris.ly/d/prisma-schema
// Generisani klijent ide u src/generated/prisma (gitignore-ovan, pravi ga `npm run db:generate`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Jedan video sa svojim HLS izlazom.
///
/// VAZNO — putanje su RELATIVNE, bez hosta i bez vodece kose crte:
///   ispravno:  "hls/clip-01-bars/master.m3u8"
///   pogresno:  "https://pub-xxx.r2.dev/hls/clip-01-bars/master.m3u8"
///   pogresno:  "/hls/clip-01-bars/master.m3u8"
///
/// Base URL se dodaje pri citanju, kroz `mediaUrl()` iz src/lib/media.ts.
/// Da apsolutni URL stoji u bazi, isti podaci ne bi mogli da se koriste u dev-u
/// i na produkciji, a promena CDN-a bi trazila UPDATE nad svim redovima.
model Video {
  id String @id @default(cuid())

  /// Citljiv identifikator; poklapa se sa imenom foldera u hls/.
  slug        String  @unique
  title       String
  description String?

  /// Trajanje u CELIM SEKUNDAMA. Jedinica je u imenu polja namerno —
  /// `duration` bi ostavilo nedoumicu da li su sekunde ili milisekunde.
  durationSeconds Int

  /// Relativna putanja do postera, npr. "hls/clip-01-bars/poster.jpg".
  posterPath String?

  /// Relativna putanja do master playliste.
  manifestPath String

  /// Podrazumevano false — video koji upadne greskom nije odmah vidljiv.
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters  Chapter[]
  subtitles Subtitle[]

  @@index([published])
}

/// Marker unutar videa — tacka na koju plejer moze da skoci.
model Chapter {
  id String @id @default(cuid())

  videoId String
  /// Brisanjem videa nestaju i njegova poglavlja; bez ovoga ostaju siročići
  /// koji pokazuju na nepostojeci red.
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  title String

  /// Pocetak poglavlja u CELIM SEKUNDAMA od pocetka videa — ista jedinica
  /// kao Video.durationSeconds.
  startSeconds Int

  /// Redosled prikaza, 0-bazno. Ne izvodi se iz startSeconds da bi poglavlja
  /// mogla da se preurede bez diranja vremena.
  order Int

  createdAt DateTime @default(now())

  /// Dva poglavlja istog videa ne mogu deliti redni broj — cuva baza, ne kod.
  @@unique([videoId, order])
  @@index([videoId])
}

/// Jedan titl (WebVTT) vezan za video.
///
/// Vazi isto pravilo kao za Video.manifestPath — putanja je RELATIVNA:
///   ispravno:  "captions/solar-eclipse.en.vtt"
///   pogresno:  "/media/captions/solar-eclipse.en.vtt"
/// Base URL dodaje `mediaUrl()` pri citanju, u src/server/videos.ts.
///
/// Zaseban model, a ne polje na Video-u, jer jedan snimak prirodno ima vise
/// jezika. Prazna lista je legitimno stanje i nosi znacenje: plejer po njoj
/// zna da CC kontrolu treba da onemoguci umesto da nudi toggle koji ne radi.
model Subtitle {
  id String @id @default(cuid())

  videoId String
  /// Brisanjem videa nestaju i njegovi titlovi — isto kao kod poglavlja.
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  /// BCP-47 oznaka jezika ("en", "sr"). Ide pravo u <track srclang>.
  lang String

  /// Ime koje korisnik vidi, na JEZIKU TITLA ("English", ne "Engleski") —
  /// tako to radi i nativni meni za titlove.
  label String

  /// Relativna putanja do titl fajla (.vtt ili .srt).
  ///
  /// Formata NEMA u bazi namerno: plejer ga cita iz sadrzaja fajla, jer
  /// ekstenzija redovno laze. Vidi `src/components/player/subtitle-source.ts`.
  path String

  /// Da li se ukljucuje sam. Za sada uvek false — titlovi se pale rucno,
  /// jer ukljuceni titlovi bez pitanja smetaju vecini gledalaca.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Jedan video ne moze imati dva titla za isti jezik — cuva baza, ne kod.
  @@unique([videoId, lang])
  @@index([videoId])
}

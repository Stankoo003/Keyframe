// Prisma schema — dokumentacija: https://pris.ly/d/prisma-schema
// Generisani klijent ide u src/generated/prisma (gitignore-ovan, pravi ga `npm run db:generate`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

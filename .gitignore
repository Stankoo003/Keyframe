# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nikad ne commit-uj prave vrednosti; .env.example je jedini izuzetak
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# media pipeline — izvorni klipovi i HLS izlaz se regenerisu skriptama iz scripts/.
# Segmenti se objavljuju na CDN, ne drze se u gitu. Vidi "Media pipeline" u README-u.
/media/
# Negacija ne radi kroz "/public/media/" — git ne silazi u iskljucen direktorijum,
# pa se predak mora otvoriti sa /* da bi izuzetak ispod uopste imao dejstva.
/public/media/*
# Izuzetak: titlovi. Razlog zasto je media ignorisana su stotine MB .ts segmenata;
# .vtt je par KB teksta koji je covek rucno pregledao. Regenerisanje nije ni
# deterministicko (whisper) ni besplatno, a svez klon bez njih ne bi mogao da
# pokaze titlove uopste.
!/public/media/captions/

# Playwright
/test-results/
/playwright-report/
/blob-report/
